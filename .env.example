# --- Database (required) ---
# prisma/schema.prisma's datasource provider is "postgresql" — this
# must be a Postgres connection string (e.g. from Neon), not a SQLite
# file path.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- NextAuth (required) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REPLACE_ME_WITH_RANDOM_STRING" # generate with: openssl rand -base64 32

# Login is database-backed (User.email + User.passwordHash; create an
# account at /signup). There are no env-based admin credentials.

# --- Google sign-in (optional, UI-2) ---
# Server-only. "Continue with Google" appears only when BOTH are set.
# OAuth client type "Web application"; authorized redirect URI:
#   <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Transactional email (M5: verification + invitations) ---
# Server-only. Resend HTTPS API (no SDK). Never expose as NEXT_PUBLIC_*.
# Without RESEND_API_KEY, production refuses to send; local development
# prints emails to the console instead. Tests never send real email.
RESEND_API_KEY="REPLACE_ME"
EMAIL_FROM="Your App <no-reply@mail.example.com>"
# Origin used for every link in emails (never derived from the request
# Host header). Production: https origin only, no path.
APP_BASE_URL="http://localhost:3000"

# --- Telegram bot (required for the Telegram integration) ---
TELEGRAM_BOT_TOKEN="REPLACE_ME_WITH_BOT_TOKEN_FROM_BOTFATHER"
# Shared secret Telegram sends back as the x-telegram-bot-api-secret-token
# header on every webhook call — must match what you registered via
# setWebhook's secret_token parameter. Without this set, the webhook
# rejects every incoming Telegram update.
TELEGRAM_WEBHOOK_SECRET="REPLACE_ME_WITH_A_RANDOM_STRING"

# --- Optional ---
# TEAM_NAME="New England Eagles"

# Rate limiting for logins and (M9.3) anonymous Match Link views/answers
# (optional, recommended in Production). If unset, these requests are NOT
# rate-limited — see src/lib/rateLimit.ts. Create a free Upstash Redis
# database at https://upstash.com and paste its REST URL/token below
# to activate.
# UPSTASH_REDIS_REST_URL="REPLACE_ME"
# UPSTASH_REDIS_REST_TOKEN="REPLACE_ME"

# M9-D — optional AI match recaps via the OpenAI Responses API (server-side
# only; never NEXT_PUBLIC_*). Without OPENAI_API_KEY the app offers the
# deterministic recap only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Optional: reasoning effort for this short copywriting task (default "low";
# "off" omits the parameter). OPENAI_BASE_URL is only for test injection —
# production uses the official https://api.openai.com/v1 by default.
# OPENAI_REASONING_EFFORT=low
# OPENAI_BASE_URL=

# M9.3 — Match Links (players answer attendance / see teams without an account).
# DEDICATED secret, separate from NEXTAUTH_SECRET; at least 32 characters.
# Without it, match links are unavailable (organizers see a configuration
# message; nothing falls back). Rotating it invalidates every match link
# (organizers then copy the new links from Share Match).
# Generate with: openssl rand -hex 32
MATCH_SHARE_SECRET="REPLACE_ME_WITH_A_DEDICATED_RANDOM_SECRET"

# M11.2A — Stripe billing (TEST MODE ONLY in M11.2A). Billing stays OFF unless
# BILLING_ENABLED="true" AND a TEST secret key (sk_test_… / rk_test_…), the
# webhook signing secret and both Price ids are set. Live keys (sk_live_…) are
# rejected in code throughout M11.2A, whatever BILLING_ALLOW_LIVE_MODE says.
# Leave all of these UNSET in Production until live billing is approved.
# BILLING_ENABLED="true"
# STRIPE_SECRET_KEY="sk_test_REPLACE_ME"
# STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"          # from the test-mode webhook endpoint
# STRIPE_PRICE_PRO_MONTHLY="price_REPLACE_ME"       # $9.99 / month, USD
# STRIPE_PRICE_PRO_ANNUAL="price_REPLACE_ME"        # $99 / year, USD
# STRIPE_PORTAL_CONFIGURATION_ID="bpc_REPLACE_ME"   # optional (default Portal configuration otherwise)
# BILLING_ALLOW_LIVE_MODE=""                        # reserved for M11.2B; has no effect in M11.2A
