# --- Database (required) ---
# prisma/schema.prisma's datasource provider is "postgresql" — this
# must be a Postgres connection string (e.g. from Neon), not a SQLite
# file path.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- NextAuth (required) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REPLACE_ME_WITH_RANDOM_STRING" # generate with: openssl rand -base64 32

# --- Admin login (required) ---
# Single-admin, env-based credential for this phase (see architecture
# audit for the planned move to a real User table pre-SaaS).
ADMIN_EMAIL="admin@yourteam.com"
ADMIN_PASSWORD_HASH="REPLACE_ME_WITH_BCRYPT_HASH" # node -e "require('bcrypt').hash('yourPassword',10).then(console.log)"

# --- Telegram bot (required for the Telegram integration) ---
TELEGRAM_BOT_TOKEN="REPLACE_ME_WITH_BOT_TOKEN_FROM_BOTFATHER"
# Shared secret Telegram sends back as the x-telegram-bot-api-secret-token
# header on every webhook call — must match what you registered via
# setWebhook's secret_token parameter. Without this set, the webhook
# rejects every incoming Telegram update.
TELEGRAM_WEBHOOK_SECRET="REPLACE_ME_WITH_A_RANDOM_STRING"

# --- Optional ---
# TEAM_NAME="New England Eagles"

# Login rate limiting (optional). If unset, login attempts are NOT
# rate-limited — see src/lib/rateLimit.ts. Create a free Upstash Redis
# database at https://upstash.com and paste its REST URL/token below
# to activate.
# UPSTASH_REDIS_REST_URL="REPLACE_ME"
# UPSTASH_REDIS_REST_TOKEN="REPLACE_ME"
