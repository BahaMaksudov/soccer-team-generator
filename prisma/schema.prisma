generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Position {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
}

enum Rating {
  FAIR
  GOOD
  VERY_GOOD
  EXCELLENT
}

// Phase 2D.6D.5D — durable canonical Close Poll + Post Teams record.
// NULL (on TelegramPoll.teamsPostStatus) means "no canonical durable
// posting record", NOT "teams were never posted": historical rows are
// deliberately left NULL (no backfill), because legacy Publish may have
// posted teams without recording it anywhere.
enum TelegramTeamsPostStatus {
  SENDING
  POSTED
}

// ============================================================
// Phase 2B — additive SaaS/multi-tenancy foundation.
//
// These models and the nullable groupId columns below establish the
// structural shape only. Nothing reads/writes them yet: no rows are
// created, no application code is scoped by tenant, and every
// existing constraint (TeamGeneration.date, TelegramUserLink's
// unique columns, Player.telegramUserId, TelegramChat.chatId,
// AppSetting.key) is left exactly as it was. Backfill, application
// scoping, and constraint changes are later phases (2C+).
// ============================================================

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String?
  // M5 — set only by a successful email verification (or, once, by
  // migration #13 for Users who already owned an Organization before
  // self-service signup existed). NULL = unverified.
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships             OrganizationMembership[]
  emailVerificationTokens EmailVerificationToken[]

  // M5 — invitations this User created / accepted (audit trail only;
  // never an authorization source — OrganizationMembership is).
  invitationsCreated  OrganizationInvitation[] @relation("InvitationCreatedBy")
  invitationsAccepted OrganizationInvitation[] @relation("InvitationAcceptedBy")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMembership[]
  groups      Group[]
  invitations OrganizationInvitation[]
}

model OrganizationMembership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

// M5 — proof-of-ownership token for a User's email address. Only the
// SHA-256 hash of the random token is stored; the raw token exists only
// in the verification link. Bound to one User and the normalized email
// it was sent to; single-use (usedAt) and time-limited (expiresAt).
// Issuing a new token deletes the User's older unused ones. Separate
// from OrganizationInvitation — the two token types never interchange.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// M5 — invitation to join an Organization. Only the SHA-256 hash of the
// random token is stored; the raw token exists only in the invitation
// link. Bound to one Organization, one normalized email and one role —
// acceptance never reads any of those from the client. Single-use
// (acceptedAt) and time-limited (expiresAt).
model OrganizationInvitation {
  id               String    @id @default(cuid())
  organizationId   String
  // Normalized (trimmed, lowercased) at creation.
  email            String
  role             OrgRole
  tokenHash        String    @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  createdByUserId  String?
  createdAt        DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("InvitationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  acceptedBy   User?        @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
}

model Group {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  sportKey       String   @default("soccer")
  // Required, no default: every Group created from here on must have
  // an explicit IANA timezone. The one existing production group gets
  // its value (America/New_York) during Phase 2C backfill, not here —
  // Phase 2B creates zero Group rows, so this being required is safe.
  timezone       String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  players         Player[]
  teamGenerations TeamGeneration[]
  settings        GroupSetting[]
  telegramChats   TelegramChat[]
  telegramPolls   TelegramPoll[]
  telegramLinks   TelegramUserLink[]

  @@unique([organizationId, slug])
}

model GroupSetting {
  id        String   @id @default(cuid())
  groupId   String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, key])
}

model Player {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  position  Position
  rating    Rating
  stamina   Int      @default(3)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ✅ NEW (Telegram link)
  telegramUserId   BigInt? @unique
  telegramUsername String?
  telegramFirst    String?
  telegramLast     String?

  telegramLink TelegramUserLink[]

  // Phase 2D.7 — required (NOT NULL): every row belongs to exactly one
  // Group. onDelete: Restrict — a Group cannot be deleted while it still
  // owns rows here; a future Group-deletion workflow must remove or
  // archive its tenant data first.
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Restrict)
}

model TeamGeneration {
  id        String   @id @default(cuid())
  // Phase 2D.2b: uniqueness is now per-Group, not global — see
  // @@unique below. A Group may have at most one TeamGeneration per
  // date; different Groups may each have their own record for the
  // same date.
  date      DateTime
  teamsJson String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Phase 2D.7 — required (NOT NULL): every row belongs to exactly one
  // Group. onDelete: Restrict — a Group cannot be deleted while it still
  // owns rows here; a future Group-deletion workflow must remove or
  // archive its tenant data first.
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@unique([groupId, date])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model TelegramPoll {
  pollId      String   @id
  chatId      BigInt
  messageId   BigInt?
  question    String
  optionsJson String
  isClosed    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pollDate DateTime?

  // Phase 2D.6D.5D — canonical close-and-post idempotency state
  // machine: NULL -> SENDING (atomic conditional claim) -> POSTED
  // (confirmed sendMessage success). SENDING is reset to NULL only on a
  // definite Telegram rejection (ok:false); an ambiguous send failure
  // leaves it SENDING so it can never be resent automatically. Written
  // only by src/lib/telegramCloseAndPost.ts — legacy Publish never
  // reads or writes these columns. All nullable, no default, no index,
  // no backfill.
  teamsPostStatus        TelegramTeamsPostStatus?
  postedTeamGenerationId String?
  teamsPostClaimedAt     DateTime?
  teamsPostedAt          DateTime?

  answers TelegramPollAnswer[]

  // Phase 2D.7 — required (NOT NULL): every row belongs to exactly one
  // Group. onDelete: Restrict — a Group cannot be deleted while it still
  // owns rows here; a future Group-deletion workflow must remove or
  // archive its tenant data first.
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Restrict)
}

model TelegramPollAnswer {
  id            String   @id @default(cuid())
  pollId        String
  userId        BigInt
  username      String?
  firstName     String?
  lastName      String?
  optionIdsJson String
  updatedAt     DateTime @updatedAt

  poll TelegramPoll @relation(fields: [pollId], references: [pollId], onDelete: Cascade)

  // Scalar only (no relation/foreign key), denormalized from the parent
  // poll's groupId. Phase 2D.7 — required (NOT NULL).
  groupId String

  @@unique([pollId, userId])
}

model TelegramUserLink {
  id        String   @id @default(cuid())
  // Unchanged — global uniqueness stays until the linking-mechanism
  // consolidation + Phase 2I's (groupId, userId)/(groupId, playerId)
  // compound constraints replace it.
  userId    BigInt   @unique
  playerId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // Phase 2D.7 — required (NOT NULL): every row belongs to exactly one
  // Group. onDelete: Restrict — a Group cannot be deleted while it still
  // owns rows here; a future Group-deletion workflow must remove or
  // archive its tenant data first.
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Restrict)
}

model TelegramChat {
  id        Int      @id @default(autoincrement())
  // Unchanged — Telegram's own chat-id namespace is genuinely global,
  // this constraint never needs to change shape.
  chatId    BigInt   @unique
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Phase 2D.7 — required (NOT NULL): every row belongs to exactly one
  // Group. onDelete: Restrict — a Group cannot be deleted while it still
  // owns rows here; a future Group-deletion workflow must remove or
  // archive its tenant data first.
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Restrict)
}
