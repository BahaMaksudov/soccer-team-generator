generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// M7: the soccer-only `enum Position` was removed — Player.position is now a
// sport-scoped role key (TEXT), validated against the Group's SportDefinition
// (src/lib/sports). Existing values (GOALKEEPER/DEFENDER/MIDFIELDER/FORWARD)
// were preserved byte-for-byte by migration #17.

enum Rating {
  FAIR
  GOOD
  VERY_GOOD
  EXCELLENT
}

// Phase 2D.6D.5D — durable canonical Close Poll + Post Teams record.
// NULL (on TelegramPoll.teamsPostStatus) means "no canonical durable
// posting record", NOT "teams were never posted": historical rows are
// deliberately left NULL (no backfill), because legacy Publish may have
// posted teams without recording it anywhere.
enum TelegramTeamsPostStatus {
  SENDING
  POSTED
}

// ============================================================
// Phase 2B — additive SaaS/multi-tenancy foundation.
//
// These models and the nullable groupId columns below establish the
// structural shape only. Nothing reads/writes them yet: no rows are
// created, no application code is scoped by tenant, and every
// existing constraint (TeamGeneration.date, TelegramUserLink's
// unique columns, Player.telegramUserId, TelegramChat.chatId,
// AppSetting.key) is left exactly as it was. Backfill, application
// scoping, and constraint changes are later phases (2C+).
// ============================================================

// M6-A — who may view a Group's player-facing pages (published teams,
// roster names). Organizer access (OrganizationMembership) is unaffected.
//   PUBLIC  — anyone with the Group URL.
//   LINK    — only holders of an active GroupShareLink (no account).
//   PRIVATE — only authorized Team Balance Pro users.
enum GroupVisibility {
  PRIVATE
  LINK
  PUBLIC
}

// M6-B — durable delivery of a core business event to an external
// channel. Only TELEGRAM/TEAMS_PUBLISHED are used today; WHATSAPP/EMAIL and
// further events are added by extending these enums.
enum MessageChannel {
  TELEGRAM
}

enum MessageEventType {
  TEAMS_PUBLISHED
  // M9-A — explicit "Post attendance poll" for a Match (reserved before sendPoll).
  ATTENDANCE_POLL_POSTED
  // M9-D — explicit post-game messages of a Match (each organizer-triggered).
  MVP_POLL_POSTED
  MATCH_RESULT_POSTED
  MVP_ANNOUNCED
  MATCH_RECAP_POSTED
  // M9-D — the combined "Post Match Summary" (published result + optional MVP + recap).
  MATCH_SUMMARY_POSTED
}

// M9-D — where an MVP vote came from (provider-neutral; WHATSAPP in M10).
enum MvpVoteSource {
  TELEGRAM
  WEB
}

// M9-D — HOW Player of the Match is determined for a Match (one method per
// Match, never competing workflows). PLAYER_VOTE = the Telegram poll among
// published participants; ORGANIZER_SELECTION = an OWNER/ADMIN picks one
// published participant directly (no Telegram needed). Separate from
// MvpDecision, which only describes how a PLAYER_VOTE result was resolved.
enum MvpMethod {
  PLAYER_VOTE
  ORGANIZER_SELECTION
}

// M9-D — how the published MVP was decided. VOTES = a unique top vote count;
// CO_MVP = a tie published as co-MVPs; ORGANIZER_TIEBREAK = the organizer
// picked one Player from the tied set (recorded, never presented as a vote win).
enum MvpDecision {
  VOTES
  CO_MVP
  ORGANIZER_TIEBREAK
}

// M9-D — provenance of the recap text. AI = unchanged AI output; AI_EDITED =
// the organizer edited AI output; DETERMINISTIC = the built-in fact recap.
enum RecapSource {
  DETERMINISTIC
  AI
  AI_EDITED
  MANUAL
}

// M9-A — Match lifecycle. Only these states are stored; attendance open/
// closed, teams ready/published etc. are derived from the data.
enum MatchStatus {
  SCHEDULED
  COMPLETED
  CANCELED
}

// M9-A — channel-neutral attendance. MAYBE is never "confirmed".
enum AttendanceStatus {
  PLAYING
  NOT_PLAYING
  MAYBE
}

// M9-A — where the participant's own (latest) response came from. Organizer
// overrides are stored separately (AttendanceResponse.override*). WHATSAPP
// arrives with M10.
enum AttendanceSource {
  WEB
  TELEGRAM
}

// M9-A — what a Telegram poll is for. Legacy polls read as ATTENDANCE; MVP
// polls arrive with M9-B.
// M9-B — how a Player entered a Telegram chat's scope (always an explicit
// OWNER/ADMIN action; SUGGESTED_VOTE = accepted from the linked-voter suggestions).
enum TelegramChatPlayerSource {
  ORGANIZER
  SUGGESTED_VOTE
}

enum TelegramPollKind {
  ATTENDANCE
  MVP
}

//   SENDING   — reserved before the external send (one at a time per poll).
//   SENT      — the channel accepted it (or an organizer confirmed it).
//   FAILED    — the channel definitively rejected it; safe to retry.
//   UNCERTAIN — outcome unknown (timeout/network/unreadable reply, or a
//               SENDING reservation that never finished); NEVER retried
//               automatically — an organizer marks it sent or retries.
enum MessageDeliveryStatus {
  SENDING
  SENT
  FAILED
  UNCERTAIN
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String?
  // M5 — set only by a successful email verification (or, once, by
  // migration #13 for Users who already owned an Organization before
  // self-service signup existed). NULL = unverified.
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships             OrganizationMembership[]
  emailVerificationTokens EmailVerificationToken[]
  // M6-A — optional claimed Player profiles (none yet; claim flow is M6-C).
  players                 Player[]
  shareLinksCreated       GroupShareLink[]
  deliveriesCreated       MessageDelivery[]        @relation("DeliveryCreatedBy")
  deliveriesResolved      MessageDelivery[]        @relation("DeliveryResolvedBy")
  playerClaimsCreated     PlayerClaim[]            @relation("ClaimCreatedBy")
  playerClaimsAccepted    PlayerClaim[]            @relation("ClaimAcceptedBy")
  playerClaimsUnlinked    PlayerClaim[]            @relation("ClaimUnlinkedBy")
  telegramConnectCodes    TelegramConnectCode[]

  // M5 — invitations this User created / accepted (audit trail only;
  // never an authorization source — OrganizationMembership is).
  invitationsCreated  OrganizationInvitation[] @relation("InvitationCreatedBy")
  invitationsAccepted OrganizationInvitation[] @relation("InvitationAcceptedBy")

  // M9-A — audit only.
  matchesCreated             Match[]                @relation("MatchCreatedBy")
  attendanceOverrides        AttendanceResponse[]   @relation("AttendanceOverrideBy")
  telegramChatBindCodes      TelegramChatBindCode[]
  // M9-B — audit only.
  telegramChatPlayersCreated TelegramChatPlayer[]   @relation("ChatPlayerCreatedBy")
  // M9-D — audit only.
  resultsPublished           MatchResult[]          @relation("ResultPublishedBy")
  resultsUpdated             MatchResult[]          @relation("ResultUpdatedBy")
  mvpsOpened                 MatchMvp[]             @relation("MvpOpenedBy")
  mvpsPublished              MatchMvp[]             @relation("MvpPublishedBy")
  mvpsSelected               MatchMvp[]             @relation("MvpSelectedBy")
  recapsGenerated            MatchRecap[]           @relation("RecapGeneratedBy")
  recapsPublished            MatchRecap[]           @relation("RecapPublishedBy")
  recapsUpdated              MatchRecap[]           @relation("RecapUpdatedBy")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMembership[]
  groups      Group[]
  invitations OrganizationInvitation[]
}

model OrganizationMembership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

// M5 — proof-of-ownership token for a User's email address. Only the
// SHA-256 hash of the random token is stored; the raw token exists only
// in the verification link. Bound to one User and the normalized email
// it was sent to; single-use (usedAt) and time-limited (expiresAt).
// Issuing a new token deletes the User's older unused ones. Separate
// from OrganizationInvitation — the two token types never interchange.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// M5 — invitation to join an Organization. Only the SHA-256 hash of the
// random token is stored; the raw token exists only in the invitation
// link. Bound to one Organization, one normalized email and one role —
// acceptance never reads any of those from the client. Single-use
// (acceptedAt) and time-limited (expiresAt).
model OrganizationInvitation {
  id               String    @id @default(cuid())
  organizationId   String
  // Normalized (trimmed, lowercased) at creation.
  email            String
  role             OrgRole
  tokenHash        String    @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  createdByUserId  String?
  createdAt        DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("InvitationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  acceptedBy   User?        @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
}

model Group {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  slug           String
  sportKey       String          @default("soccer")
  // Required, no default: every Group created from here on must have
  // an explicit IANA timezone. The one existing production group gets
  // its value (America/New_York) during Phase 2C backfill, not here —
  // Phase 2B creates zero Group rows, so this being required is safe.
  timezone       String
  isActive       Boolean         @default(true)
  // M6-A — new Groups default to LINK; migration #14 sets every Group
  // that existed before it to PUBLIC (unchanged behavior).
  visibility     GroupVisibility @default(LINK)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  players               Player[]
  teamGenerations       TeamGeneration[]
  settings              GroupSetting[]
  telegramChats         TelegramChat[]
  telegramPolls         TelegramPoll[]
  telegramLinks         TelegramUserLink[]
  shareLinks            GroupShareLink[]
  deliveries            MessageDelivery[]
  playerClaims          PlayerClaim[]
  telegramConnectCodes  TelegramConnectCode[]
  // M9-A
  matches               Match[]
  attendanceResponses   AttendanceResponse[]
  telegramChatBindCodes TelegramChatBindCode[]
  // M9-B
  telegramChatPlayers   TelegramChatPlayer[]
  // M9-D
  matchResults          MatchResult[]
  matchMvps             MatchMvp[]
  matchMvpVotes         MatchMvpVote[]
  matchRecaps           MatchRecap[]

  @@unique([organizationId, slug])
}

model GroupSetting {
  id        String   @id @default(cuid())
  groupId   String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, key])
}

// M6-B — one delivery of a core event (TEAMS_PUBLISHED) to a channel
// destination (a Telegram chat). Holds delivery state only; the business
// content stays in TeamGeneration. `contentHash` = SHA-256 of the
// delivered message body without any link ("legacy" for rows copied from
// the pre-M6-B TelegramPoll posting columns). No raw provider responses,
// share tokens or URLs are stored.
model MessageDelivery {
  id                String                @id @default(cuid())
  groupId           String
  eventType         MessageEventType
  channel           MessageChannel
  // Channel address; for TELEGRAM the chat id.
  destination       String
  // Context: the Telegram poll these teams answer, and the published teams.
  telegramPollId    String?
  teamGenerationId  String?
  contentHash       String
  status            MessageDeliveryStatus
  attempts          Int                   @default(1)
  claimedAt         DateTime
  sentAt            DateTime?
  failedAt          DateTime?
  providerMessageId String?
  // Safe category (TELEGRAM_REJECTED, TIMEOUT, NETWORK, UNREADABLE_RESPONSE,
  // STALE_RESERVATION) and a short, truncated provider description.
  failureCode       String?
  failureDetail     String?
  // MARKED_SENT when an organizer confirmed an uncertain delivery.
  resolution        String?
  resolvedAt        DateTime?
  resolvedByUserId  String?
  createdByUserId   String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  group          Group           @relation(fields: [groupId], references: [id], onDelete: Restrict)
  telegramPoll   TelegramPoll?   @relation(fields: [telegramPollId], references: [pollId], onDelete: SetNull)
  teamGeneration TeamGeneration? @relation(fields: [teamGenerationId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation("DeliveryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  resolvedBy     User?           @relation("DeliveryResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  // M9-A — the Match this communication belongs to (NULL for legacy rows).
  matchId String?
  match   Match?  @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@index([telegramPollId, channel])
  @@index([teamGenerationId])
  @@index([matchId, eventType, channel])
}

// M6-C — organizer-issued, single-use link that lets ONE person link their
// Team Balance Pro account to an EXISTING Player (Player.userId). Only the
// SHA-256 of the random token is stored; the raw token is shown once.
// The row is also the claim's audit trail: created (by whom), accepted (by
// which User, when), revoked/replaced, and — if an organizer later unlinks
// the account — unlinked (by whom, when).
model PlayerClaim {
  id               String    @id @default(cuid())
  playerId         String
  groupId          String
  tokenHash        String    @unique
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  createdByUserId  String?
  usedAt           DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  unlinkedAt       DateTime?
  unlinkedByUserId String?

  player     Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  group      Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy  User?  @relation("ClaimCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  acceptedBy User?  @relation("ClaimAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  unlinkedBy User?  @relation("ClaimUnlinkedBy", fields: [unlinkedByUserId], references: [id], onDelete: SetNull)

  @@index([playerId])
  @@index([groupId])
}

// M6-C — short-lived, single-use code a claimed Player's account creates
// and sends to the Telegram bot (/connect CODE) to link that Telegram
// identity to the Player in its Group. Only the SHA-256 is stored.
model TelegramConnectCode {
  id                   String    @id @default(cuid())
  playerId             String
  groupId              String
  codeHash             String    @unique
  expiresAt            DateTime
  createdAt            DateTime  @default(now())
  createdByUserId      String?
  usedAt               DateTime?
  usedByTelegramUserId BigInt?

  player    Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([playerId])
}

// M6-A — revocable viewer access to one Group's player-facing pages
// (no account). Only the SHA-256 hash of the random token is stored; the
// raw token is returned once, at creation. Rotation revokes every active
// link of the Group and creates a new one. Not a membership: grants
// read-only access to allow-listed player-facing data only.
model GroupShareLink {
  id              String    @id @default(cuid())
  groupId         String
  tokenHash       String    @unique
  createdByUserId String?
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([groupId])
}

model Player {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  // M7: sport-scoped role key (see src/lib/sports); was enum Position.
  position  String
  rating    Rating
  stamina   Int      @default(3)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ✅ NEW (Telegram link)
  telegramUserId   BigInt? @unique
  telegramUsername String?
  telegramFirst    String?
  telegramLast     String?

  telegramLink TelegramUserLink[]

  // Phase 2D.7 — required (NOT NULL): every row belongs to exactly one
  // Group. onDelete: Restrict — a Group cannot be deleted while it still
  // owns rows here; a future Group-deletion workflow must remove or
  // archive its tenant data first.
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Restrict)

  // M6-A — OPTIONAL Team Balance Pro account that has claimed this
  // Player (claim flow: M6-C). A Player never requires a User. Deleting
  // the User keeps the Player and its history (SET NULL). A User may
  // claim at most one Player per Group, and Players in many Groups.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  claims               PlayerClaim[]
  telegramConnectCodes TelegramConnectCode[]
  attendanceResponses  AttendanceResponse[]
  telegramChatPlayers  TelegramChatPlayer[]
  mvpVotesCast         MatchMvpVote[]        @relation("MvpVoter")
  mvpVotesReceived     MatchMvpVote[]        @relation("MvpCandidate")

  @@unique([groupId, userId])
  // Composite target for TelegramChatPlayer's (playerId, groupId) FK.
  @@unique([id, groupId])
  @@index([userId])
}

model TeamGeneration {
  id        String   @id @default(cuid())
  // Phase 2D.2b: uniqueness is now per-Group, not global — see
  // @@unique below. A Group may have at most one TeamGeneration per
  // date; different Groups may each have their own record for the
  // same date.
  date      DateTime
  teamsJson String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // M7 — generation metadata recorded on publish. NULL on rows published
  // before M7 (= legacy soccer generation); never backfilled. metricsJson
  // holds aggregate BalanceMetrics only (no player ids/names/identity).
  sportKey      String?
  engineVersion String?
  metricsJson   String?

  // Phase 2D.7 — required (NOT NULL): every row belongs to exactly one
  // Group. onDelete: Restrict — a Group cannot be deleted while it still
  // owns rows here; a future Group-deletion workflow must remove or
  // archive its tenant data first.
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Restrict)

  deliveries MessageDelivery[]

  // M9-A — the Match these teams belong to (NULL for legacy/by-date
  // generations; never backfilled). One generation per Match.
  matchId String? @unique
  match   Match?  @relation(fields: [matchId], references: [id], onDelete: SetNull)

  // M9-B — identity: a Match-linked generation is identified by matchId (so
  // two Matches on the same day each keep their own teams); a legacy
  // generation (matchId NULL) by (groupId, date). The latter is a PARTIAL
  // unique index created in raw SQL (migration #19) that Prisma cannot
  // express: "TeamGeneration_groupId_date_legacy_key" ON ("groupId", "date")
  // WHERE "matchId" IS NULL. Keep it when regenerating migrations.
  @@index([groupId, date])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model TelegramPoll {
  pollId      String   @id
  chatId      BigInt
  messageId   BigInt?
  question    String
  optionsJson String
  isClosed    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pollDate DateTime?

  // Phase 2D.6D.5D — canonical close-and-post idempotency state
  // machine: NULL -> SENDING (atomic conditional claim) -> POSTED
  // (confirmed sendMessage success). SENDING is reset to NULL only on a
  // definite Telegram rejection (ok:false); an ambiguous send failure
  // leaves it SENDING so it can never be resent automatically. Written
  // only by src/lib/telegramCloseAndPost.ts — legacy Publish never
  // reads or writes these columns. All nullable, no default, no index,
  // no backfill.
  teamsPostStatus        TelegramTeamsPostStatus?
  postedTeamGenerationId String?
  teamsPostClaimedAt     DateTime?
  teamsPostedAt          DateTime?

  answers TelegramPollAnswer[]

  // Phase 2D.7 — required (NOT NULL): every row belongs to exactly one
  // Group. onDelete: Restrict — a Group cannot be deleted while it still
  // owns rows here; a future Group-deletion workflow must remove or
  // archive its tenant data first.
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Restrict)

  deliveries MessageDelivery[]

  // M9-A — Telegram adapter for channel-neutral attendance. NULL for legacy
  // polls (never backfilled); legacy polls read as ATTENDANCE.
  matchId String?
  match   Match?           @relation(fields: [matchId], references: [id], onDelete: SetNull)
  kind    TelegramPollKind @default(ATTENDANCE)

  @@index([matchId])
}

model TelegramPollAnswer {
  id            String   @id @default(cuid())
  pollId        String
  userId        BigInt
  username      String?
  firstName     String?
  lastName      String?
  optionIdsJson String
  updatedAt     DateTime @updatedAt

  poll TelegramPoll @relation(fields: [pollId], references: [pollId], onDelete: Cascade)

  // Scalar only (no relation/foreign key), denormalized from the parent
  // poll's groupId. Phase 2D.7 — required (NOT NULL).
  groupId String

  @@unique([pollId, userId])
}

model TelegramUserLink {
  id        String   @id @default(cuid())
  // M6-C — Group-scoped identity: the same Telegram user may be linked to
  // one Player in EACH Group (@@unique([groupId, userId]) below). A Player
  // belongs to exactly one Group, so playerId stays unique: one Player →
  // at most one Telegram identity.
  userId    BigInt
  playerId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // Phase 2D.7 — required (NOT NULL): every row belongs to exactly one
  // Group. onDelete: Restrict — a Group cannot be deleted while it still
  // owns rows here; a future Group-deletion workflow must remove or
  // archive its tenant data first.
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@unique([groupId, userId])
}

model TelegramChat {
  id             Int       @id @default(autoincrement())
  // M9-B — a chat is ACTIVE in at most one Group at a time: partial unique
  // index "TelegramChat_chatId_active_key" ON ("chatId") WHERE
  // "disconnectedAt" IS NULL (raw SQL, migration #19). A disconnected row
  // keeps its history (scope, polls, deliveries); reconnecting the same chat
  // to the same Group reactivates that row (one row per (chatId, groupId)).
  chatId         BigInt
  title          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  // M9-B — soft disconnect (organizer action or the bot was removed).
  disconnectedAt DateTime?

  // Phase 2D.7 — required (NOT NULL): every row belongs to exactly one
  // Group. onDelete: Restrict — a Group cannot be deleted while it still
  // owns rows here; a future Group-deletion workflow must remove or
  // archive its tenant data first.
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Restrict)

  players TelegramChatPlayer[]
  matches Match[]

  @@unique([chatId, groupId])
  // Composite target for TelegramChatPlayer's (telegramChatId, groupId) FK.
  @@unique([id, groupId])
}

// M9-B — DEFAULT player scope of one connected Telegram chat (who is usually
// in that chat). Organizer-curated (Telegram cannot enumerate members), keyed
// by Player — never by a Telegram user id. Not an eligibility rule: any Group
// Player can still be added to a Match. The composite FKs make a cross-Group
// association impossible at the database level: (telegramChatId, groupId) →
// TelegramChat(id, groupId) and (playerId, groupId) → Player(id, groupId).
model TelegramChatPlayer {
  id              String                   @id @default(cuid())
  groupId         String
  telegramChatId  Int
  playerId        String
  source          TelegramChatPlayerSource @default(ORGANIZER)
  createdByUserId String?
  createdAt       DateTime                 @default(now())

  group     Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  chat      TelegramChat @relation(fields: [telegramChatId, groupId], references: [id, groupId], onDelete: Cascade)
  player    Player       @relation(fields: [playerId, groupId], references: [id, groupId], onDelete: Cascade)
  createdBy User?        @relation("ChatPlayerCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([telegramChatId, playerId])
  @@index([groupId])
  @@index([playerId])
}

// M9-A — a scheduled game of one Group. Identity is the id, NOT the date: a
// Group may have several Matches on the same day. The date is a date-only
// value (UTC midnight, like TeamGeneration.date) interpreted in the Group's
// timezone; startTime is optional local "HH:MM". locationName is a plain
// label (no address/coordinates).
model Match {
  id                 String      @id @default(cuid())
  groupId            String
  date               DateTime
  startTime          String?
  locationName       String?
  status             MatchStatus @default(SCHEDULED)
  attendanceClosedAt DateTime?
  // M9-B — the organizer's selected Telegram chat (communication context and
  // default player scope). NOT evidence that anything was sent: TelegramPoll /
  // MessageDelivery record actual sends. Server-validated to be this Group's.
  telegramChatId     Int?
  createdByUserId    String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  group         Group                @relation(fields: [groupId], references: [id], onDelete: Restrict)
  createdBy     User?                @relation("MatchCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  telegramChat  TelegramChat?        @relation(fields: [telegramChatId], references: [id], onDelete: SetNull)
  attendance    AttendanceResponse[]
  generation    TeamGeneration?
  telegramPolls TelegramPoll[]
  deliveries    MessageDelivery[]
  // M9-D — post-game (each Match-keyed, at most one; never Telegram-owned).
  result        MatchResult?
  mvp           MatchMvp?
  mvpVotes      MatchMvpVote[]
  recap         MatchRecap?

  @@index([groupId])
  @@index([groupId, date])
  @@index([telegramChatId])
}

// M9-D — the factual final result of a Match (entered by an organizer; AI
// never sets or changes it). `scoresJson` = [{ teamNumber, score }] for EVERY
// team of the Match's published teams (team identity = the published
// snapshot's teamNumber; future team names hang off the same key). Saved =
// organizer-only draft; publishedAt set = visible on the Match page. Editing
// a published result keeps it published (a correction); Telegram is never
// updated automatically (MessageDelivery content hash → "Post Updated").
model MatchResult {
  id                String    @id @default(cuid())
  groupId           String
  matchId           String    @unique
  scoresJson        String
  publishedAt       DateTime?
  publishedByUserId String?
  updatedByUserId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  group       Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  match       Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  publishedBy User? @relation("ResultPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  updatedBy   User? @relation("ResultUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([groupId])
}

// M9-D — MVP voting of a Match. Candidates are Players of the Match's
// PUBLISHED teams (snapshot ids); `candidatePlayerIds` is ordered = the poll's
// option order (option index → Player). Voting is open while openedAt is set
// and closedAt is not. Winners are decided deterministically from the votes at
// publish (ties: co-MVPs or an organizer tie-break, recorded in `decision`).
model MatchMvp {
  id                 String       @id @default(cuid())
  groupId            String
  matchId            String       @unique
  candidatePlayerIds String[]
  openedAt           DateTime?
  openedByUserId     String?
  closedAt           DateTime?
  winnerPlayerIds    String[]
  decision           MvpDecision?
  // M9-D (enhancement) — determination method + the organizer's saved (not yet
  // published) selection. NULL method on rows created before = PLAYER_VOTE
  // when a vote was started (derived in code; no backfill). selectedPlayerId
  // is validated against the published participants (like winnerPlayerIds).
  method             MvpMethod?
  selectedPlayerId   String?
  selectedByUserId   String?
  selectedAt         DateTime?
  publishedAt        DateTime?
  publishedByUserId  String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  group       Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  match       Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  openedBy    User? @relation("MvpOpenedBy", fields: [openedByUserId], references: [id], onDelete: SetNull)
  selectedBy  User? @relation("MvpSelectedBy", fields: [selectedByUserId], references: [id], onDelete: SetNull)
  publishedBy User? @relation("MvpPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)

  @@index([groupId])
}

// M9-D — ONE current MVP vote per voting Player of a Match (latest valid
// answer wins; a retracted answer deletes it). Only participants of the
// published teams vote, never for themselves (enforced server-side).
// Provider-neutral: Telegram answers are mapped TelegramUserLink → Player.
// Composite FKs keep voter and candidate inside the Match's Group.
model MatchMvpVote {
  id                String        @id @default(cuid())
  groupId           String
  matchId           String
  voterPlayerId     String
  candidatePlayerId String
  source            MvpVoteSource
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  match     Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  voter     Player @relation("MvpVoter", fields: [voterPlayerId, groupId], references: [id, groupId], onDelete: Cascade)
  candidate Player @relation("MvpCandidate", fields: [candidatePlayerId, groupId], references: [id, groupId], onDelete: Cascade)

  @@unique([matchId, voterPlayerId])
  @@index([groupId])
  @@index([candidatePlayerId])
}

// M9-D — the Match recap (plain text). `content` is the organizer's canonical
// text (draft until publishedAt); `generatedContent` keeps the latest AI
// output so the source (AI vs AI_EDITED) is decided server-side. AI never
// publishes or sends; only verified facts go to the AI provider.
model MatchRecap {
  id                String       @id @default(cuid())
  groupId           String
  matchId           String       @unique
  content           String?
  source            RecapSource?
  generatedContent  String?
  generatedAt       DateTime?
  generatedByUserId String?
  publishedAt       DateTime?
  publishedByUserId String?
  updatedByUserId   String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  group       Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  match       Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  generatedBy User? @relation("RecapGeneratedBy", fields: [generatedByUserId], references: [id], onDelete: SetNull)
  publishedBy User? @relation("RecapPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  updatedBy   User? @relation("RecapUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([groupId])
}

// M9-A — one row per (Match, Player). Keeps BOTH the participant's own latest
// response (web or a linked Telegram vote) and an organizer override; the
// effective status is override ?? participant (src/lib/attendance.ts). No
// provider identities (Telegram ids) are stored here.
model AttendanceResponse {
  id                     String            @id @default(cuid())
  matchId                String
  groupId                String
  playerId               String
  participantStatus      AttendanceStatus?
  participantSource      AttendanceSource?
  participantRespondedAt DateTime?
  overrideStatus         AttendanceStatus?
  overrideByUserId       String?
  overrideAt             DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  match      Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  group      Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  player     Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  overrideBy User?  @relation("AttendanceOverrideBy", fields: [overrideByUserId], references: [id], onDelete: SetNull)

  @@unique([matchId, playerId])
  @@index([groupId])
}

// M9-A — one-time proof that an OWNER/ADMIN wants to connect a Telegram
// group to this Group: 15-minute, single-use, stored only as a SHA-256 hash
// (code format "g_" + 128-bit base64url). Redeemed in the Telegram group by a
// verified Telegram chat administrator.
model TelegramChatBindCode {
  id              String    @id @default(cuid())
  groupId         String
  codeHash        String    @unique
  expiresAt       DateTime
  createdByUserId String?
  usedAt          DateTime?
  usedChatTitle   String?
  createdAt       DateTime  @default(now())

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([groupId])
}
